# BEACON Server Environment Variables
# Copy to .env and fill in values

# Database (SQLite for G0-G2, PostgreSQL upgrade path)
DATABASE_URL=sqlite:///./beacon.db
# DATABASE_URL=postgresql://user:password@localhost/beacon

# CORS (dashboard origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQL debugging
SQL_ECHO=false

# API Keys (Sbu holds these — repo is PUBLIC)
# WEATHER_API_KEY=
# ESKOM_SE_PUSH_KEY=

# Operator roster for POST /v1/entities/{id}/verify (team/SBU.md, 2026-07-25).
# JSON object {operator_id: token}. Caller must send the matching token in
# the X-Operator-Token header, or the request is rejected with 401 — without
# this, anyone could write any operator_id into the evidence_chain.
# OPERATOR_TOKENS={"op_001": "<real-token>", "op_002": "<real-token>"}

# Rate limit for state-changing requests (POST/PUT/PATCH/DELETE), per IP per
# path, per 60s window (server/src/middleware/rate_limit.py). Default 120.
# RATE_LIMIT_PER_MINUTE=120

# ── Computer vision ──────────────────────────────────────────────────────────
# Roboflow key for the plate and weapon models. The pipeline calls the models
# directly (detect.roboflow.com), not the workflows — measured ~1.1s per frame
# with both models in parallel, against 8-14s through the workflow services.
# ROBOFLOW_API_KEY=

# hosted | local. Default: local if the `inference` package is importable, else
# hosted. Do NOT pip install `inference` into this environment — it pins
# pydantic <2.12 and pulls two extra OpenCV builds, which breaks the server.
# It belongs in its own container (see infra/main.bicep, the vision apps).
# VISION_BACKEND=hosted

# ── Escalation email ─────────────────────────────────────────────────────────
# Sent ONLY when a named human escalates — server/src/notify/email.py refuses
# to send for anything the machine raised on its own.
#
# sendgrid | resend
EMAIL_PROVIDER=sendgrid

# SendGrid: Settings > API Keys > Create API Key. "Restricted Access" with only
# "Mail Send" enabled is enough — do not use a Full Access key in a repo this
# public, even in a file that's gitignored.
# SENDGRID_API_KEY=

# Resend alternative. Its shared sender needs no domain setup, which is why
# it's worth keeping as a fallback if SendGrid sender verification stalls you.
# RESEND_API_KEY=

# The From address. SendGrid REJECTS anything that is not a verified sender:
# do Settings > Sender Authentication > Single Sender Verification first, and
# put that exact address here. This is the most common reason a first SendGrid
# send comes back 403.
# ESCALATION_FROM=BEACON <your-verified-address@example.com>

# Who receives escalations — comma-separated. In production this is the private
# security provider's control room; for a demo, your own address.
# ESCALATION_TO=

# ── Azure (values come from infra/deploy.ps1 output) ─────────────────────────
# AZURE_STORAGE_ACCOUNT=
# KEY_VAULT_URI=
